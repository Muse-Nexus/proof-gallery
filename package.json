{
  "name": "@muse-nexus/proof-gallery",
  "version": "0.2.0",
  "private": false,
  "description": "A local-first, source-faithful evidence gallery for the moments when your own history is hard to reach.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:integration:local": "bun tests/integration/proof-gallery.integration.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:integration": "tsc -p tsconfig.integration.json",
    "check": "bun run typecheck && bun run typecheck:integration && bun run test && bun run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.23"
}
