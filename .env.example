VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-local-anon-key

# Edge Function settings. Set these as server-side secrets, never as VITE_
# browser variables. When no embedding provider is configured, private lexical
# search remains fully available.
# ALLOWED_ORIGINS=http://localhost:5173
# OPENAI_API_KEY=replace-with-your-server-side-key
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=replace-with-your-custom-provider-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
